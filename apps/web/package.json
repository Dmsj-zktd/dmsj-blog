{
  "name": "@dmsj/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind --force-language zh",
    "preview": "astro preview",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=chromium",
    "test:visual": "playwright test e2e/visual.spec.ts --project=chromium",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "astro": "^7.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "katex": "^0.18.5",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@dmsj/content-model": "workspace:*",
    "pagefind": "^1.5.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.129.0"
  }
}
