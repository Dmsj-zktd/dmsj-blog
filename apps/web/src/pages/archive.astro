---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { ui } from "@/i18n/zh-CN";
import { getPublishedPosts } from "@/lib/posts";

const posts = await getPublishedPosts();
const years = [...new Set(posts.map((p) => p.date.getFullYear()))].sort((a, b) => b - a);
---

<BaseLayout title={`${ui.archive.title} · ${new Date().getFullYear()}`}>
  <div class="shell page-wrap">
    <h1>{ui.archive.title}</h1>
    <p class="muted">{ui.archive.total.replace("{total}", String(posts.length))}</p>
    <div class="archive-list">
      {years.map((year) => (
        <section class="year-block">
          <h2 id={`year-${year}`}>{year}</h2>
          <div class="year-posts">
            {posts
              .filter((p) => p.date.getFullYear() === year)
              .map((post) => <ArticleCard post={post} showExcerpt={false} />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .page-wrap {
    max-width: 56rem;
    padding-block: 2.5rem 1rem;
  }

  .page-wrap > h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin-block-end: 0.2rem;
  }

  .muted {
    color: var(--fg-soft);
  }

  .year-block {
    margin-block-start: 1.8rem;
  }

  .year-block > h2 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-soft);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.35rem;
    letter-spacing: 0.08em;
  }

  .year-posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0.8rem;
    margin-block-start: 0.8rem;
  }
</style>
