---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { getPublishedPosts } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.tags.includes(tag));
---

<BaseLayout title={`#${tag} · DMSJ`} description={`与 ${tag} 相关的 DMSJ 技术笔记。`}>
  <header class="shell page-hero">
    <p class="mono-label">Tag route</p>
    <h1>#{tag}</h1>
    <p class="page-hero__lead">{posts.length} 篇笔记在这个概念下相交。</p>
    <a class="text-link" href="/tags/">返回标签索引</a>
  </header>
  <div class="shell section">
    {posts.map((post, index) => <ArticleCard post={post} index={index} />)}
  </div>
</BaseLayout>
