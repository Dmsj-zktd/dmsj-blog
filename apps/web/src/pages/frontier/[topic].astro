---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import TopicDiagram from "@/components/TopicDiagram.astro";
import { frontierTopics, weightedFrontierScore } from "@dmsj/content-model";
import { getPublishedPosts } from "@/lib/posts";
import { getLab } from "@/lib/labs";

export function getStaticPaths() {
  return frontierTopics.map((topic) => ({
    params: { topic: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const allPosts = await getPublishedPosts();
const articles = topic.articles
  .map((id) => allPosts.find((post) => post.id === id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const fusion = topic.fusion
  .map((id) => allPosts.find((post) => post.id === id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const lab = getLab(topic.lab);
const score = weightedFrontierScore(topic.score);
const scoreFields = [
  ["新颖度", topic.score.novelty, 20],
  ["实用性", topic.score.usefulness, 25],
  ["证据", topic.score.evidence, 25],
  ["工程价值", topic.score.engineering, 20],
  ["边缘相关", topic.score.edgeFit, 10],
] as const;
---

<BaseLayout
  title={`${topic.title} · 前沿研究 · DMSJ`}
  description={topic.thesis}
  keywords={[topic.shortTitle, "AI systems", "embedded", "research"]}
>
  <div class="shell">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">DMSJ</a>
      <span aria-hidden="true">/</span>
      <a href="/frontier/">前沿研究</a>
      <span aria-hidden="true">/</span>
      <span>{topic.shortTitle}</span>
    </nav>
  </div>

  <header class="shell topic-hero">
    <div class="topic-hero__main">
      <p class="mono-label">Frontier / {String(topic.rank).padStart(2, "0")} · {topic.domain === "ai" ? "AI SYSTEM" : "EMBEDDED / EDGE"}</p>
      <h1>{topic.title}</h1>
      <p class="topic-hero__question">{topic.question}</p>
      <p class="topic-hero__thesis">{topic.thesis}</p>
      <div class="topic-hero__actions">
        <a class="btn btn--primary" href={`/lab/${topic.lab}/`}>进入配套实验</a>
        {articles[0] && <a class="btn" href={articles[0].urlPath}>先读旗舰笔记</a>}
      </div>
    </div>
    <aside class="topic-score">
      <div class="topic-score__head">
        <span>EDITORIAL SCORE</span>
        <strong>{score}</strong>
        <small>/ 5</small>
      </div>
      <dl>
        {scoreFields.map(([label, value, weight]) => (
          <div>
            <dt>{label}<small>{weight}%</small></dt>
            <dd><i style={`--v:${value * 20}%`}></i><span>{value.toFixed(1)}</span></dd>
          </div>
        ))}
      </dl>
      <p>编辑评分不等于客观引用量，详细方法见研究雷达。</p>
    </aside>
  </header>

  <section class="shell">
    <TopicDiagram topicId={topic.id} />
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="mono-label">Research notes / 两篇结构</p>
        <h2>先建立模型，再用实验拆边界</h2>
      </div>
    </div>
    {articles.length > 0 ? (
      <div class="topic-notes">
        {articles.map((post, index) => <ArticleCard post={post} index={index} />)}
      </div>
    ) : (
      <p class="empty-state">相关笔记正在整理。</p>
    )}
  </section>

  <section class="shell section topic-lab">
    <div class="topic-lab__intro">
      <p class="mono-label">Instrument</p>
      <h2>{lab?.shortTitle ?? "配套实验"}</h2>
      <p>{lab?.staticConclusion ?? "用参数模型检查这个主题的关键约束。"}</p>
      <a class="btn btn--embedded" href={`/lab/${topic.lab}/`}>打开实验</a>
    </div>
    <div class="topic-lab__fields">
      {lab?.fields.slice(0, 4).map((field) => (
        <div>
          <span>{field.label}</span>
          <strong>{field.value} <small>{field.unit}</small></strong>
          <small>{field.hint}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="shell section sources">
    <div class="section-heading">
      <div>
        <p class="mono-label">Primary sources / 一手证据</p>
        <h2>可追溯的起点</h2>
      </div>
    </div>
    <ol>
      {topic.sources.map((source) => (
        <li>
          <span>{source.publisher}{source.year ? ` · ${source.year}` : ""}</span>
          <a href={source.url} rel="noreferrer">{source.title}</a>
          <small>{source.kind.toUpperCase()}</small>
        </li>
      ))}
    </ol>
  </section>

  {fusion.length > 0 && (
    <section class="shell section fusion">
      <div class="section-heading">
        <div>
          <p class="mono-label">Cross-domain synthesis</p>
          <h2>把这个主题放回系统主线</h2>
        </div>
      </div>
      {fusion.map((post, index) => <ArticleCard post={post} index={index} />)}
    </section>
  )}
</BaseLayout>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-block: 1.2rem;
    color: var(--ink-faint);
    font: 0.68rem var(--font-mono);
  }

  .breadcrumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .topic-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 22rem);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    border-block-start: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    padding-block: clamp(2.2rem, 5vw, 4rem);
  }

  .topic-hero h1 {
    max-width: 20ch;
    margin: 0.7rem 0 1rem;
    font-size: clamp(2.4rem, 6.2vw, 6rem);
    font-weight: 620;
    letter-spacing: -0.072em;
    line-height: 0.95;
  }

  .topic-hero__question {
    max-width: 42rem;
    margin: 0;
    color: var(--ai);
    font-family: var(--font-reading);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.4rem);
    line-height: 1.55;
  }

  .topic-hero__thesis {
    max-width: 50rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: 0.93rem;
  }

  .topic-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.4rem;
  }

  .topic-score {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: 1rem;
    box-shadow: var(--shadow-tight);
  }

  .topic-score__head {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    border-block-end: 1px solid var(--line);
    padding-block-end: 0.7rem;
  }

  .topic-score__head span {
    flex: 1;
    color: var(--ink-faint);
    font: 0.62rem var(--font-mono);
  }

  .topic-score__head strong {
    color: var(--ai);
    font-size: 3rem;
    font-weight: 620;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .topic-score__head small {
    color: var(--ink-faint);
    font: 0.66rem var(--font-mono);
  }

  .topic-score dl {
    display: grid;
    gap: 0.55rem;
    margin: 0.85rem 0;
  }

  .topic-score dl div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: center;
  }

  .topic-score dt {
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .topic-score dt small {
    margin-inline-start: 0.25rem;
    color: var(--ink-faint);
    font: 0.56rem var(--font-mono);
  }

  .topic-score dd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.7rem;
    gap: 0.4rem;
    align-items: center;
    margin: 0;
  }

  .topic-score dd:before {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    height: 2px;
    background: var(--line);
    content: "";
  }

  .topic-score dd i {
    grid-column: 1;
    grid-row: 1;
    width: var(--v);
    height: 2px;
    background: var(--ai);
  }

  .topic-score dd span {
    grid-column: 2;
    grid-row: 1;
    color: var(--ink-faint);
    font: 0.62rem var(--font-mono);
    text-align: end;
  }

  .topic-score > p {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.65rem;
    line-height: 1.5;
  }

  .topic-notes {
    border-block-start: 1px solid var(--line);
  }

  .topic-lab {
    display: grid;
    grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
    border-block-start: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
  }

  .topic-lab__intro h2 {
    margin: 0.45rem 0 0.7rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 620;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .topic-lab__intro p:last-of-type {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .topic-lab__intro .btn {
    margin-block-start: 0.8rem;
  }

  .topic-lab__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }

  .topic-lab__fields > div {
    display: grid;
    align-content: start;
    border-block-end: 1px solid var(--line);
    border-inline-end: 1px solid var(--line);
    padding: 0.8rem;
  }

  .topic-lab__fields span {
    color: var(--ink-faint);
    font: 0.62rem var(--font-mono);
  }

  .topic-lab__fields strong {
    margin-block: 0.5rem 0.2rem;
    color: var(--embedded);
    font-size: 1.4rem;
    font-weight: 610;
  }

  .topic-lab__fields strong small {
    color: var(--ink-faint);
    font: 0.6rem var(--font-mono);
  }

  .topic-lab__fields > div > small {
    color: var(--ink-faint);
    font-size: 0.63rem;
  }

  .sources ol {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--line);
    list-style: none;
  }

  .sources li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 5rem;
    gap: 1rem;
    align-items: center;
    border-block-end: 1px solid var(--line);
    padding-block: 0.8rem;
  }

  .sources li span,
  .sources li small {
    color: var(--ink-faint);
    font: 0.62rem var(--font-mono);
  }

  .sources li a {
    color: var(--ink);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .sources li small {
    text-align: end;
  }

  .fusion {
    border-block-start: 1px solid var(--line);
  }

  @media (max-width: 880px) {
    .topic-hero,
    .topic-lab {
      grid-template-columns: 1fr;
    }

    .topic-score {
      max-width: 28rem;
    }
  }

  @media (max-width: 620px) {
    .topic-lab__fields {
      grid-template-columns: 1fr;
    }

    .sources li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .sources li small {
      text-align: start;
    }
  }
</style>
