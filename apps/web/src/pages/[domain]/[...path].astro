---
import { getCollection, render } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Comments from "@/components/Comments.astro";
import { site } from "@/config/site";
import { contentModules, getModule, humanizeCategorySegment } from "@/site/content-registry";
import { getAllPosts, formatDate, getReadingMinutes, type PostSummary } from "@/lib/posts";

type Props =
  | {
      kind: "module";
      moduleKey: string;
    }
  | {
      kind: "dir";
      moduleKey: string;
      dirPath: string;
    }
  | {
      kind: "article";
      id: string;
    };

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const paths: Array<{ params: { domain: string; path?: string }; props: Props }> = [];

  for (const module of contentModules) {
    paths.push({
      params: { domain: module.key, path: undefined },
      props: { kind: "module", moduleKey: module.key },
    });
    const domainPosts = posts.filter((p) => p.domain === module.key && !p.draft);
    const dirSeen = new Set<string>();
    for (const post of domainPosts) {
      paths.push({
        params: { domain: module.key, path: post.id.slice(module.key.length + 1) },
        props: { kind: "article", id: post.id },
      });
      let acc = "";
      for (const dir of post.dirs) {
        acc = acc ? `${acc}/${dir}` : dir;
        if (!dirSeen.has(acc)) {
          dirSeen.add(acc);
          paths.push({
            params: { domain: module.key, path: acc },
            props: { kind: "dir", moduleKey: module.key, dirPath: acc },
          });
        }
      }
    }
  }
  return paths;
}

const props = Astro.props;
const allPosts = await getAllPosts();

let modulePosts: PostSummary[] = [];
let moduleTitle = "";
let categoryTitle = "";
let breadcrumb: string[] = [];
let post: PostSummary | undefined;
let renderedContent: Awaited<ReturnType<typeof render>> | undefined;

if (props.kind === "module" || props.kind === "dir") {
  const module = getModule(props.moduleKey);
  if (module) {
    moduleTitle = module.label;
    modulePosts = allPosts.filter((p) => p.domain === module.key && !p.draft);
    if (props.kind === "dir") {
      const dirs = props.dirPath.split("/");
      const prefix = `${module.key}/${props.dirPath}/`;
      modulePosts = modulePosts.filter((p) => p.id.startsWith(prefix));
      categoryTitle = dirs.map(humanizeCategorySegment).join(" / ");
      breadcrumb = dirs;
    }
  }
} else {
  const entry = await getCollection("blog");
  const found = entry.find((e) => e.id === props.id);
  const summary = allPosts.find((p) => p.id === props.id);
  if (found && summary) {
    post = summary;
    renderedContent = await render(found);
    breadcrumb = summary.dirs;
  }
}

const pageTitle = post
  ? post.title
  : categoryTitle
    ? `${categoryTitle} · ${moduleTitle}`
    : moduleTitle;

const tocItems =
  renderedContent?.headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3) ?? [];

const listingModuleKey =
  props.kind === "module" || props.kind === "dir" ? props.moduleKey : undefined;
const listingDirs = props.kind === "dir" ? props.dirPath.split("/") : [];
---

<BaseLayout
  title={pageTitle}
  description={post?.description ?? modulePosts[0]?.description}
>
  {
    post && renderedContent ? (
      <article class="shell article-page">
        <header class="article-head">
          <nav class="crumbs" aria-label="面包屑">
            <a href="/">首页</a>
            <span aria-hidden="true">/</span>
            <a href={`/${post.domain}/`}>{moduleTitle}</a>
            {breadcrumb.map((segment, index) => (
              <>
                <span aria-hidden="true">/</span>
                <a
                  href={`/${post.domain}/${breadcrumb.slice(0, index + 1).join("/")}/`}
                >
                  {humanizeCategorySegment(segment)}
                </a>
              </>
            ))}
          </nav>
          <h1>{post.title}</h1>
          <p class="article-lead">{post.description}</p>
          <div class="article-meta">
            <time datetime={post.date.toISOString()}>
              {formatDate(post.date)}
            </time>
            {post.updated && (
              <span>
                更新于 {formatDate(post.updated)}
              </span>
            )}
            <span>{getReadingMinutes(post.body)} 分钟阅读</span>
          </div>
          {post.tags.length > 0 && (
            <div class="tag-row">
              {post.tags.map((tag) => (
                <a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="article-layout">
          {
            tocItems.length > 0 && (
              <aside class="toc-wrap no-print" aria-label="目录">
                <p class="eyebrow">目录</p>
                <nav>
                  {tocItems.map((heading) => (
                    <a
                      class:list={[
                        "toc-link",
                        heading.depth === 3 ? "toc-link--sub" : "",
                      ]}
                      href={`#${heading.slug}`}
                    >
                      {heading.text}
                    </a>
                  ))}
                </nav>
              </aside>
            )
          }
          <div class="article surface">
            <renderedContent.Content />
          </div>
        </div>

        <footer class="article-foot no-print">
          <Comments />
          <p class="article-license">
            本文遵循 {site.license.content} · 源码见 GitHub 仓库
          </p>
        </footer>
      </article>
      <script is:inline src="/scripts/article.js" defer></script>
    ) : (
      <div class="shell page-wrap">
        {listingModuleKey && (
          <nav class="crumbs" aria-label="面包屑">
            <a href="/">首页</a>
            <span aria-hidden="true">/</span>
            <a href={`/${listingModuleKey}/`}>{moduleTitle}</a>
            {listingDirs.map((segment, index) => (
              <>
                <span aria-hidden="true">/</span>
                <a
                  href={`/${listingModuleKey}/${listingDirs.slice(0, index + 1).join("/")}/`}
                >
                  {humanizeCategorySegment(segment)}
                </a>
              </>
            ))}
          </nav>
        )}
        <h1>{pageTitle}</h1>
        {categoryTitle && (
          <p class="muted">
            {modulePosts.length} 篇 · {categoryTitle}
          </p>
        )}
        {modulePosts.length > 0 ? (
          <div class="domain-grid">
            {modulePosts.map((item) => <ArticleCard post={item} />)}
          </div>
        ) : (
          <p class="muted">该内容域还没有公开文章。</p>
        )}
      </div>
    )
  }
</BaseLayout>

<style is:global>
  .article-page {
    padding-block: 2rem 1rem;
  }

  .article-head {
    max-width: 50rem;
    margin-inline: auto;
    margin-block-end: 2rem;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--fg-faint);
    margin-block-end: 1rem;
  }

  .crumbs a {
    color: var(--fg-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .article-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    line-height: 1.3;
    margin: 0.3rem 0 0.7rem;
    letter-spacing: -0.01em;
  }

  .article-lead {
    color: var(--fg-soft);
    font-size: 1.05rem;
    margin-block-end: 1rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
    margin-block-end: 0.7rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .article {
    padding: clamp(1.1rem, 3vw, 2.2rem);
    width: min(100%, var(--measure-wide));
    margin-inline: auto;
  }

  .article-layout .article {
    max-width: none;
  }

  .toc-wrap {
    position: sticky;
    top: 5.4rem;
    max-height: calc(100vh - 7rem);
    overflow: auto;
    border-left: 1px solid var(--hairline);
    padding-inline-start: 1rem;
    display: none;
  }

  .toc-wrap nav {
    display: grid;
    gap: 0.25rem;
    margin-block-start: 0.5rem;
  }

  .toc-link {
    color: var(--fg-soft);
    font-size: 0.86rem;
    text-decoration: none;
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--accent);
  }

  .toc-link--sub {
    padding-inline-start: 0.9rem;
    font-size: 0.8rem;
    color: var(--fg-faint);
  }

  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0.9rem;
    margin-block-start: 1.4rem;
  }

  .article-foot {
    max-width: 50rem;
    margin: 2.5rem auto 0;
  }

  .article-license {
    color: var(--fg-faint);
    font-size: 0.8rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    }
    .toc-wrap {
      display: block;
    }
    .article-layout .article {
      grid-column: 2;
    }
  }
</style>
