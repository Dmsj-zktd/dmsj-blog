---
import { siGitee, siGithub } from "simple-icons";

import { site } from "@/config/site";

const icons = {
  github: siGithub,
  gitee: siGitee,
} as const;
---

<ul class="social-list" aria-label="个人主页">
  {site.author.social.map((item) => (
    <li>
      <a class="social-link" href={item.url} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d={icons[item.id].path} />
        </svg>
        <span>{item.label}</span>
      </a>
    </li>
  ))}
</ul>

<style is:global>
  .social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--hairline);
    background: var(--bg-elev);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: border-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .social-link:active {
    transform: translateY(0) scale(0.98);
  }
</style>
