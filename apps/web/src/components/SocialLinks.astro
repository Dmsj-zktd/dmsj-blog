---
import { site } from "@/config/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<ul class:list={["social-links", compact && "social-links--compact"]} aria-label="个人主页">
  {
    site.author.social.map((link) => (
      <li>
        <a class="social-link" href={link.url} rel="me noreferrer">
          <span aria-hidden="true">{link.id === "github" ? "GH" : "GE"}</span>
          {!compact && <span>{link.label}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .social-link {
    display: inline-flex;
    min-height: 2.6rem;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    padding: 0.3rem 0.7rem;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .social-link span:first-child {
    color: var(--ink-faint);
    font: 0.63rem var(--font-mono);
  }

  .social-link:hover {
    border-color: var(--ink);
    text-decoration: none;
  }

  .social-links--compact .social-link {
    min-width: 2.6rem;
    justify-content: center;
    padding-inline: 0.5rem;
  }
</style>
