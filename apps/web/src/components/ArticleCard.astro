---
import type { PostSummary } from "@/lib/posts";
import { formatDate, getReadingMinutes, moduleOfPost } from "@/lib/posts";

interface Props {
  post: PostSummary;
  showExcerpt?: boolean;
  featured?: boolean;
  index?: number;
}

const { post, showExcerpt = true, featured = false, index } = Astro.props;
const module = moduleOfPost(post);
const isSilicon = post.domain === "embedded";
const kindLabels = {
  note: "笔记",
  lab: "实验",
  synthesis: "综合研究",
  essay: "随笔",
  project: "项目",
  flagship: "旗舰研究",
  experiment: "实验笔记",
} as const;
---

<article
  class:list={[
    "article-card",
    isSilicon ? "article-card--silicon" : "article-card--reasoning",
    featured ? "article-card--featured" : "",
  ]}
>
  <div class="article-card__rail" aria-hidden="true">
    <span></span>
    <i></i>
  </div>
  <div class="article-card__body">
    <div class="article-card__meta">
      {typeof index === "number" && <span>{String(index + 1).padStart(2, "0")}</span>}
      <span class="article-card__kind">{kindLabels[post.kind] ?? "笔记"}</span>
      {module && <span>{module.label}</span>}
      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      <span>{getReadingMinutes(post.body)} 分钟</span>
    </div>
    <h2 class="article-card__title">
      <a href={post.urlPath}>{post.title}</a>
    </h2>
    {showExcerpt && <p class="article-card__excerpt">{post.description}</p>}
    <div class="article-card__foot">
      <div class="article-card__tags">
        {post.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
      </div>
      <span class="article-card__open" aria-hidden="true">
        <span aria-hidden="true">阅读</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>
</article>

<style is:global>
  .article-card {
    --card-accent: var(--ai);
    position: relative;
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    gap: 0.9rem;
    border-block-end: 1px solid var(--line);
    background: transparent;
    padding-block: 1.15rem;
    transition: background-color 180ms ease;
  }

  .article-card--silicon {
    --card-accent: var(--embedded);
  }

  .article-card:hover {
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }

  .article-card__rail {
    display: grid;
    grid-template-rows: 0.38rem 1fr;
    justify-items: center;
    gap: 0.35rem;
    padding-block-start: 0.44rem;
  }

  .article-card__rail span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--card-accent);
  }

  .article-card__rail i {
    width: 1px;
    height: 100%;
    background: linear-gradient(var(--card-accent), transparent);
    opacity: 0.45;
  }

  .article-card__body {
    min-width: 0;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem 0.65rem;
    align-items: center;
    color: var(--ink-faint);
    font: 500 0.68rem/1.5 var(--font-mono);
  }

  .article-card__kind {
    color: var(--card-accent);
  }

  .article-card__title {
    max-width: 36ch;
    margin: 0.28rem 0 0;
    font-size: clamp(1.12rem, 1rem + 0.5vw, 1.55rem);
    font-weight: 630;
    letter-spacing: -0.028em;
    line-height: 1.24;
  }

  .article-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .article-card__title a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .article-card__excerpt {
    max-width: 58ch;
    margin: 0.42rem 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .article-card__foot {
    display: flex;
    min-height: 1.8rem;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 0.45rem;
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--ink-faint);
    font-size: 0.7rem;
  }

  .article-card__tags span::before {
    content: "#";
  }

  .article-card__open {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.76rem;
    text-decoration: none;
  }

  .article-card__open svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    transition: transform 160ms var(--ease-out);
  }

  .article-card:hover .article-card__open svg {
    transform: translateX(0.2rem);
  }

  .article-card--featured {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: 1.3rem 1.2rem;
  }

  .article-card--featured .article-card__title {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
  }
</style>
