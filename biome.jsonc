{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "AGENTS.md",
      "apps/web/src/**/*.{ts,css}",
      "apps/web/functions/**/*.ts",
      "apps/web/drizzle/**/*.ts",
      "apps/web/tests/**/*.ts",
      "apps/admin/src/**/*.{ts,css}",
      "package.json",
      "apps/web/package.json",
      "apps/admin/package.json",
      "biome.jsonc"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
