{
  "name": "dmsj-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dmsj/web dev",
    "dev:admin": "pnpm --filter @dmsj/admin dev",
    "build": "pnpm --filter @dmsj/admin build && pnpm --filter @dmsj/web build",
    "check": "pnpm -r check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts --grep-invert @visual",
    "test:a11y": "playwright test --config apps/web/playwright.config.ts --grep @a11y",
    "test:visual": "playwright test --config apps/web/playwright.config.ts --grep @visual --project=chromium",
    "test:preview": "playwright test --config apps/web/playwright.config.ts --grep \"deployed preview smoke\"",
    "budgets": "node scripts/check-performance-budget.mjs",
    "links:check": "node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "preview": "pnpm --filter @dmsj/web preview",
    "labs": "tsx labs/generate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
